	<calculatedField>
		<dataPath>Интервал</dataPath>
		<expression>Выбор 
	Когда КоличествоОтгрузок &lt;= 1 Тогда 
		"разовая"
	Иначе 
		РазностьДат(ДатаПервойОтгрузки, ДатаПоследнейОтгрузки, "ДЕНЬ") / КоличествоОтгрузок
Конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Интервал</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Срок</dataPath>
		<expression>РазностьДат(ДатаПоследнейОтгрузки, &amp;КонецПериода, "ДЕНЬ")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Срок</v8:content>
			</v8:item>
		</title>
	</calculatedField>
