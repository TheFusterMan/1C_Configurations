
Процедура ОбработкаПроведения(Отказ, Режим)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВводТехникиВРаботуСписокОборудования.Оборудование КАК Оборудование,
	                      |	СУММА(ВводТехникиВРаботуСписокОборудования.Количество) КАК Требуется
	                      |ПОМЕСТИТЬ ВТ_ВыбранноеОборудование
	                      |ИЗ
	                      |	Документ.ВводТехникиВРаботу.СписокОборудования КАК ВводТехникиВРаботуСписокОборудования
	                      |ГДЕ
	                      |	ВводТехникиВРаботуСписокОборудования.Ссылка = &Ссылка
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВводТехникиВРаботуСписокОборудования.Оборудование
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(ОстаткиОборудованияОстатки.КоличествоОстаток, 0) КАК Остаток,
	                      |	ОстаткиОборудованияОстатки.Оборудование КАК Оборудование,
	                      |	ВТ_ВыбранноеОборудование.Требуется КАК Требуется
	                      |ИЗ
	                      |	ВТ_ВыбранноеОборудование КАК ВТ_ВыбранноеОборудование
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиОборудования.Остатки(
	                      |				&МоментВремени,
	                      |				Оборудование В
	                      |						(ВЫБРАТЬ
	                      |							ВТ.Оборудование
	                      |						ИЗ
	                      |							ВТ_ВыбранноеОборудование КАК ВТ)
	                      |					И Статус = &Статус) КАК ОстаткиОборудованияОстатки
	                      |		ПО ВТ_ВыбранноеОборудование.Оборудование = ОстаткиОборудованияОстатки.Оборудование");
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыОборудования.НаСкладе);
	
	ВыбранноеОборудование = Запрос.Выполнить().Выбрать();
	
	Движения.ОстаткиОборудования.Записывать = Истина;
	Пока ВыбранноеОборудование.Следующий() Цикл
		Если ВыбранноеОборудование.Остаток < ВыбранноеОборудование.Требуется Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает оборудования " + ВыбранноеОборудование.Оборудование + 
				" для проведения операции. Остаток на складе: " + ВыбранноеОборудование.Остаток; 
			Сообщение.Сообщить();			
			Отказ = Истина;
			Прервать;
		КонецЕсли;
		
		Движение = Движения.ОстаткиОборудования.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Оборудование = ВыбранноеОборудование.Оборудование;
		Движение.Статус = Перечисления.СтатусыОборудования.НаСкладе;
		Движение.Количество = ВыбранноеОборудование.Требуется;
		
		Движение = Движения.ОстаткиОборудования.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Оборудование = ВыбранноеОборудование.Оборудование;
		Движение.Статус = Перечисления.СтатусыОборудования.ВРаботе;
		Движение.РабочееМесто = РабочееМесто;
		Движение.Количество = ВыбранноеОборудование.Требуется;
	КонецЦикла;
КонецПроцедуры
