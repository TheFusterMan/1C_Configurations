
Процедура ОбработкаПроведения(Отказ, Режим)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СписаниеТехникиСписокОборудования.Оборудование КАК Оборудование,
	                      |	СУММА(СписаниеТехникиСписокОборудования.Количество) КАК Требуется
	                      |ПОМЕСТИТЬ ВТ_ВыбранноеОборудование
	                      |ИЗ
	                      |	Документ.СписаниеТехники.СписокОборудования КАК СписаниеТехникиСписокОборудования
	                      |ГДЕ
	                      |	СписаниеТехникиСписокОборудования.Ссылка = &Ссылка
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	СписаниеТехникиСписокОборудования.Оборудование
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(ОстаткиОборудованияОстатки.КоличествоОстаток, 0) КАК Остаток,
	                      |	ОстаткиОборудованияОстатки.Оборудование КАК Оборудование,
	                      |	ОстаткиОборудованияОстатки.РабочееМесто КАК РабочееМесто,
	                      |	ВТ_ВыбранноеОборудование.Требуется КАК Требуется
	                      |ИЗ
	                      |	ВТ_ВыбранноеОборудование КАК ВТ_ВыбранноеОборудование
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиОборудования.Остатки(
	                      |				&МоментВремени,
	                      |				Оборудование В
	                      |						(ВЫБРАТЬ
	                      |							ВТ.Оборудование
	                      |						ИЗ
	                      |							ВТ_ВыбранноеОборудование КАК ВТ)
	                      |					И Статус = &Статус И РабочееМесто = &РабочееМесто) КАК ОстаткиОборудованияОстатки
	                      |		ПО ВТ_ВыбранноеОборудование.Оборудование = ОстаткиОборудованияОстатки.Оборудование");
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыОборудования.ВРаботе);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	
	ВыбранноеОборудование = Запрос.Выполнить().Выбрать();
	
	Движения.ОстаткиОборудования.Записывать = Истина;
	Пока ВыбранноеОборудование.Следующий() Цикл
		Если ВыбранноеОборудование.Остаток < ВыбранноеОборудование.Требуется Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает оборудования " + ВыбранноеОборудование.Оборудование + 
				" для списания. Используется в работе: " + ВыбранноеОборудование.Остаток; 
			Сообщение.Сообщить();			
			Отказ = Истина;
			Прервать;
		КонецЕсли;
		
		Движение = Движения.ОстаткиОборудования.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Оборудование = ВыбранноеОборудование.Оборудование;
		Движение.Статус = Перечисления.СтатусыОборудования.Списано; 
		Движение.Количество = ВыбранноеОборудование.Требуется;
	КонецЦикла;
КонецПроцедуры
