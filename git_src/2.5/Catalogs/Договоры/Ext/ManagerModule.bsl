Функция ПолучитьДоговорАванса(Контрагент) Экспорт
	Договор = Справочники.Договоры.НайтиПоНаименованию("Аванс", Истина, , Контрагент);
	
	Если Договор.Пустая() Тогда
		Договор = Справочники.Договоры.СоздатьЭлемент();
		Договор.Наименование = "Аванс";
		Договор.Владелец = Контрагент;
		Договор.Записать();
	КонецЕсли; 
	
	Возврат Договор;
КонецФункции