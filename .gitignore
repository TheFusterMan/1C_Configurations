# Игнорируем абсолютно все папки и файлы в корне репозитория...
/*

# ...кроме нашего файла исключений, батника и папки с чистым исходным кодом!
!/.gitignore
!/export_all.bat
!/git_src/

# Внутри папки git_src разрешаем отслеживать всё
!/git_src/**

# На всякий случай игнорируем логи батника, если они создаются рядом с ним
*_log.txt
